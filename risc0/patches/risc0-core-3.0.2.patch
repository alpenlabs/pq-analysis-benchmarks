+/// Operation counters. Added by the stark-boolean-verifier patch; not part of
+/// upstream risc0-core.
+pub mod counters {
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    /// `Elem` additions.
+    pub static ADD: AtomicU64 = AtomicU64::new(0);
+    /// `Elem` subtractions (`Neg` is `0 - x` and lands here).
+    pub static SUB: AtomicU64 = AtomicU64::new(0);
+    /// `Elem` multiplications, including those inside `pow` and `inv`.
+    pub static MUL: AtomicU64 = AtomicU64::new(0);
+    /// `Elem::pow` calls (`inv` is `pow(P - 2)` and lands here too).
+    pub static POW_CALLS: AtomicU64 = AtomicU64::new(0);
+    /// `Elem` multiplications spent inside `pow`; depends on the exponent bits.
+    pub static POW_MUL: AtomicU64 = AtomicU64::new(0);
+    /// `Elem::inv` calls.
+    pub static INV_CALLS: AtomicU64 = AtomicU64::new(0);
+
+    #[inline(always)]
+    pub(crate) fn bump(c: &AtomicU64) {
+        c.fetch_add(1, Relaxed);
+    }
+}
+
 impl ops::Add for Elem {
     type Output = Self;
 
     /// Addition for Baby Bear [Elem]
     fn add(self, rhs: Self) -> Self {
+        counters::bump(&counters::ADD);
         Elem(add(self.ensure_valid().0, rhs.ensure_valid().0))
     }
 }
